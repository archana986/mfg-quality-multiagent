%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#1B3139", "primaryTextColor": "#FFFFFF", "primaryBorderColor": "#00A972", "lineColor": "#2272B4", "secondaryColor": "#00A972", "tertiaryColor": "#F9F7F4", "edgeLabelBackground": "#F9F7F4", "clusterBkg": "#EAF4F0", "clusterBorder": "#00A972", "titleColor": "#1B3139", "fontFamily": "Arial, sans-serif", "fontSize": "14px"}}}%%
flowchart LR
    U["User asks a question<br/>(natural language)"] --> S

    subgraph ORCH["Supervisor Agent (the router / 'brain')"]
        S{"Which specialist<br/>should answer this?"}
    end

    S -->|"Sales numbers?"| G1["Genie Agent: Sales<br/>(text to SQL on Sales tables)"]
    S -->|"Finance numbers?"| G2["Genie Agent: Finance<br/>(text to SQL on Finance tables)"]
    S -->|"Policy / document question?"| R["RAG / Knowledge Assistant<br/>(searches documents)"]

    G1 --> A["Answers come back<br/>to the Supervisor"]
    G2 --> A
    R --> A

    A --> V["Reporting / Visualization Agent<br/>(turns answer into a chart or summary)"]
    V --> ANS["Final answer to the user"]

    A -.->|"every step is traced"| E["MLflow 3 Evaluation<br/>Did it route correctly?<br/>Is the answer safe & relevant?"]
